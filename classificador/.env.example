# Copie este arquivo para .env e preencha os valores
# NÃO commite o .env no Git

# Token do Pipefy (Personal Access Token)
PIPEFY_TOKEN=eyJhbGciOiJIUzUxMiJ9...

# Chave da API do Claude (Anthropic)
# Gerar em: console.anthropic.com → API Keys
ANTHROPIC_KEY=sk-ant-...

# ID da etiqueta "Revisar" no Pipefy
# Como obter: Configurações do pipe → Labels → copiar o ID
LABEL_REVISAR_ID=

# Secret opcional para validar webhooks (qualquer string aleatória)
WEBHOOK_SECRET=
